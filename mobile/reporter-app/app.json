{
  "expo": {
    "name": "SecurePulse Reporter",
    "slug": "securepulse-reporter",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "securepulse-reporter",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your SecurePulse server on the local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-location", {
        "locationWhenInUsePermission": "Attach your current location to an incident report when you choose.",
        "locationAlwaysPermission": false,
        "locationAlwaysAndWhenInUsePermission": false
      }],
      ["expo-image-picker", {
        "photosPermission": "Choose a photo or video to attach as incident evidence.",
        "cameraPermission": false,
        "microphonePermission": false
      }],
      "expo-notifications"
    ]
  }
}
