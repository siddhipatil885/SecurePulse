# Browser requests stay same-origin through the development proxy.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:8000
# Optional override only when a reverse proxy exposes another authorized route.
# VITE_WS_URL=wss://your-dashboard.example/api/v1/events/stream
VITE_VIDEO_OBJECT_FIT=cover
VITE_DEBUG_DETECTIONS=false
# Never put access tokens, JWT signing keys or camera credentials in VITE_*.
