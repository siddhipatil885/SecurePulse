APP_NAME=EDI-SecurePulse
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/securepulse
# After neon deploy, run backend/scripts/sync_neon_env.py from the repo root.
DATABASE_URL_UNPOOLED=
DATABASE_STORAGE_BUDGET_BYTES=1000000000
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
EVIDENCE_STORAGE=local
EVIDENCE_BUCKET=assets
# Media remains on disk. Limits apply to reporter attachments, not Frigate footage.
REPORTER_EVIDENCE_MAX_FILES=5
REPORTER_EVIDENCE_MAX_INCIDENT_BYTES=50000000
REPORTER_EVIDENCE_MAX_PROPERTY_BYTES=1000000000
REPORTER_EVIDENCE_MIN_FREE_BYTES=1000000000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
FRIGATE_URL=https://localhost:8971
GO2RTC_URL=http://localhost:1984
FRIGATE_USERNAME=
FRIGATE_PASSWORD=
FRIGATE_VERIFY_SSL=false
SECURITY_ENGINE_URL=http://localhost:8100
SECURITY_ENGINE_DECISION_PATH=/decide
SECURITY_ENGINE_TIMEOUT_SECONDS=5
SECURITY_ENGINE_FAILURE_MODE=STORE_UNCLASSIFIED
SECURITY_ENGINE_SUPPORTS_TRACKING=false
USE_LOCAL_SECURITY_ENGINE=false
AUTH_ENABLED=false
MUTATION_RATE_LIMIT_PER_MINUTE=30
EVIDENCE_ROOT=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_EVENT_QUEUE_SIZE=256
FRIGATE_MQTT_TOPIC=frigate/events
MQTT_CLIENT_ID=securepulse-backend
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30
FRIGATE_EVENT_COOLDOWN_SECONDS=30
TRACKING_LOST_TRACK_TIMEOUT_SECONDS=3
TRACKING_MINIMUM_DETECTION_CONFIDENCE=0.5
LOG_LEVEL=INFO
FRAME_WIDTH=1280
FRAME_HEIGHT=720
# Dashboard sessions require AUTH_ENABLED=true and a JWT_SECRET of at least 32
# characters. Existing camera ownership is never granted by registration.
DASHBOARD_REGISTRATION_ENABLED=true
