# Copy to .env and replace every CHANGE_ME value with a unique local secret.
# Generate the Mosquitto password file with: ..\scripts\setup_mqtt_auth.ps1
POSTGRES_USER=securepulse
POSTGRES_PASSWORD=CHANGE_ME_ALPHANUMERIC_POSTGRES_PASSWORD
POSTGRES_DB=securepulse
POSTGRES_PORT=15432
POSTGRES_BIND_ADDRESS=127.0.0.1
# Optional explicit URL (URL-encode credentials). Empty uses bundled postgres.
# Set this only when intentionally selecting an external database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_STORAGE_BUDGET_BYTES=1000000000
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
EVIDENCE_STORAGE=local
EVIDENCE_BUCKET=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

MQTT_PORT=11883
MQTT_FRIGATE_PASSWORD=CHANGE_ME_ALPHANUMERIC_FRIGATE_PASSWORD
MQTT_BACKEND_PASSWORD=CHANGE_ME_ALPHANUMERIC_BACKEND_PASSWORD

# Supply a real publisher on /live and /webcam; the sample profile is opt-in.
# For an IP camera, use its RTSP URL. Keep credentials in this ignored file.
FRIGATE_RTSP_URL=rtsp://mediamtx:8554/live
RTSP_PORT=18554
# Paths whose video SDP must be available. For a direct front-door IP camera,
# remove live here; validate that camera separately in /health/edge.
RTSP_REQUIRED_PATHS=live,webcam

BACKEND_PORT=18000
BACKEND_BIND_ADDRESS=127.0.0.1
FRIGATE_PORT=15000
FRIGATE_BIND_ADDRESS=127.0.0.1
# Host-only signaling API for a Python backend running outside Docker.
GO2RTC_PORT=11984
FRIGATE_WEBRTC_PORT=18556
FRIGATE_WEBRTC_BIND_ADDRESS=127.0.0.1
# go2rtc does not expand this field from environment variables. When changing
# the WebRTC port/bind for LAN access, also edit go2rtc.webrtc.candidates in
# ../frigate/config/frigate.yml. Its host-local default is 127.0.0.1:18556.
TZ=UTC
MQTT_EVENT_QUEUE_SIZE=256
DETECT_FPS=5
AUTH_ENABLED=false
APP_ENV=development
# Set AUTH_ENABLED=true and a random JWT_SECRET of at least 32 characters to
# enable dashboard login. Disable self-registration for an invite-only install.
DASHBOARD_REGISTRATION_ENABLED=true
# Opt-in local drills only: recording-fake. Disabled keeps delivery intents pending.
DISPATCH_NOTIFICATION_PROVIDER=disabled
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REPORTER_EVIDENCE_MAX_BYTES=10000000
REPORTER_EVIDENCE_MAX_FILES=5
REPORTER_EVIDENCE_MAX_INCIDENT_BYTES=50000000
REPORTER_EVIDENCE_MAX_PROPERTY_BYTES=1000000000
REPORTER_EVIDENCE_MIN_FREE_BYTES=1000000000
# Compose sets /media/evidence with separate camera/read-only and reporter/writable
# mounts. For a backend run outside Compose, set EVIDENCE_ROOT in backend/.env.
