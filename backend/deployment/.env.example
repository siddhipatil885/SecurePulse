# SecurePulse Edge Deployment Configuration

# RTSP Stream Settings
# Replace with actual IP Camera RTSP URL (e.g. rtsp://admin:password@192.168.1.100:554/h264)
# Or leave default to use local RTSP stream simulator
RTSP_STREAM_URL=rtsp://rtsp-sim:8554/live

# MQTT Configuration
MQTT_PORT=1883

# Backend and PostgreSQL
BACKEND_PORT=8000
POSTGRES_PORT=5432
POSTGRES_USER=securepulse
POSTGRES_PASSWORD=securepulse
POSTGRES_DB=securepulse
AUTH_ENABLED=false
JWT_SECRET=

# Frigate Web Interface Port
FRIGATE_PORT=5000

# Address reachable by browsers for Frigate's WebRTC media connection.
# Use the Docker host's LAN IP when opening the dashboard from another device.
FRIGATE_WEBRTC_PORT=8556
FRIGATE_WEBRTC_CANDIDATE=127.0.0.1:8556

# Timezone
TZ=UTC

# Frigate detection rate. The camera/source must support this rate.
DETECT_FPS=5

# Anonymous live-track projection (Frigate remains the tracker)
TRACKING_LOST_TRACK_TIMEOUT_SECONDS=3
TRACKING_MINIMUM_DETECTION_CONFIDENCE=0.5

# Optional external security-engine request timeout. The stack falls back to
# storing an unclassified incident when no engine is deployed.
SECURITY_ENGINE_TIMEOUT_SECONDS=1
SECURITY_ENGINE_SUPPORTS_TRACKING=false
